{
  "name": "oberwatch-dashboard",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "test:model-column": "node scripts/check-agents-model-column.mjs",
    "test:costs-page": "node scripts/check-costs-page-contract.mjs",
    "test:unit": "node --test 'src/lib/**/*.test.ts'",
    "test:component-states": "node --test scripts/dashboard-states.contract.test.mjs scripts/skeleton.render.test.mjs scripts/reduced-motion.css.test.mjs scripts/npm-test-wiring.test.mjs",
    "test:provider-status": "node --test scripts/provider-status.contract.test.mjs",
    "test:agents-delete": "node --test scripts/agent-delete.render.test.mjs scripts/check-agents-delete.mjs",
    "test": "npm run test:unit && npm run test:model-column && npm run test:costs-page && npm run test:component-states && npm run test:provider-status && npm run test:agents-delete",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint:ts": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.17.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "chart.js": "^4.4.8",
    "picomatch": "^4.0.4",
    "postcss": "^8.4.49",
    "svelte": "^5.15.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
